# ---- 私有 / 敏感文件（不要提交） ----
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
secrets.*
credentials.*
.netrc
.npmrc
!**/node_modules/

# ---- 本地工具与个人配置 ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.user
*.code-workspace
.local/
.verify/
*.local.*

# ---- 依赖 / 构建产物（本项目无需构建，留作兜底） ----
node_modules/
dist/
build/
.cache/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Python（本地起静态服务器时可能产生） ----
__pycache__/
*.py[cod]
.venv/
venv/

# ---- 操作系统 ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---- 临时文件 ----
*.tmp
*.temp
*.bak
*.swp
~$*

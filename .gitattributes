# 默认按文本处理并在仓库内统一为 LF，避免 Windows / macOS 协作时整文件 diff
* text=auto eol=lf

*.html   text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.css    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
.editorconfig text eol=lf
.gitignore    text eol=lf

# 二进制资源（当前项目全程序化生成、无此类文件，留作兜底）
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.mp3    binary
*.ogg    binary
*.wav    binary
*.woff   binary
*.woff2  binary
